# ---- Deployment ----
# Required on any deployment that also has ESPN credentials. Without it the app refuses
# to serve anonymously rather than exposing your league. See DEPLOYMENT.md.
DASHBOARD_PASSWORD=

# ---- Database ----
DATABASE_URL="postgresql://user:password@localhost:5432/fantasy_front_office?schema=public"

# ---- AI (optional) ----
# Without this the app falls back to the deterministic reasoning provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- ESPN (server-side only; never NEXT_PUBLIC_*) ----
# See ESPN_INTEGRATION.md for how to obtain these.
ESPN_LEAGUE_ID=
ESPN_SEASON=2026
ESPN_S2=
ESPN_SWID=

# ---- Other data providers (optional) ----
PROJECTION_PROVIDER=manual
ADP_PROVIDER=manual
